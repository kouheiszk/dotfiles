;; 上書きする場合は ~/.local_gitconfig に記述する
[user]
	name = Kouhei Suzuki
	email = kouhei.szk@gmail.com

[core]
    excludesfile = ~/.gitignore_global
    attributesfile = ~/.gitattributes_global
    editor = nvim
    pager = nkf -w | LESSCHARSET=utf-8 less
    precomposeunicode = true
    quotepath = false
    ignorecase = false

[merge]
    tool = nvimdiff
    renamelimit = 3000
    ff = true

[color]
    ui = true

[diff]
    tool = nvimdiff
    algorithm = histogram

[difftool]
    prompt = true

[alias]
    co   = checkout
    cob  = checkout -b
    cm   = commit
    cma  = commit --amend
    st   = status --short --branch
    br   = branch
    di   = diff --color
    dic  = diff --color --cached
    ft   = fetch
    stat = log --stat --summary
    ht   = log --pretty=format:\"%C(yellow)%h%Creset %ad | %s%C(green)%d%Creset %C(cyan)[%an]%Creset\" --graph --date=short
    htd  = log --pretty=format:\"%C(yellow)%h%Creset %ad | %s%C(green)%d%Creset %C(cyan)[%an]%Creset\" --graph --date=local
    lt   = log -1 HEAD
    ld   = log -u -1
    lf   = log --follow -p
    cifu = commit --fixup=HEAD
    mt   = mergetool
    rv   = remote -v
    ru   = remote update
    rhd  = reset --hard
    rst  = reset --soft
    ps = !git push origin `git rev-parse --abbrev-ref HEAD`
    pl = !git pull origin `git rev-parse --abbrev-ref HEAD`

[include]
    path = ~/.local_gitconfig

[ghq]
  root = ~/workspace/src

[pull]
	rebase = false

[push]
	default = current

[github]
	user = kouheiszk

[init]
	defaultBranch = main

;; 個人リポジトリだけ ssh へ書き換える。ghtkn に kouheiszk 向けの App が無く、
;; https では認証が通らない。github.com 全体を書き換えると、ghtkn が担っている
;; C-FO の https アクセスまで ssh に逃げて credential helper が呼ばれなくなる
[url "ssh://git@github.com/kouheiszk/"]
	insteadOf = https://github.com/kouheiszk/

#!/bin/bash
#/ Usage: script/strap-after-setup

set -e

cd "$(dirname "$0")/.."

log()   { echo "==> $*"; }
abort() { echo '!!! $*' >&2; exit 1; }

change_default_shell_to_zsh() {
  local brew_zsh='/opt/homebrew/bin/zsh'
  # $SHELL は再ログインするまで更新されないので、実際のログインシェルを見る
  local login_shell="$(dscl . -read "/Users/$(id -un)" UserShell | awk '{ print $2 }')"

  if [ -f "$brew_zsh" ]; then
    if ! grep -qx "$brew_zsh" /etc/shells; then
      echo "$brew_zsh" | sudo tee -a /etc/shells > /dev/null
    fi
  fi

  case $login_shell in
    "$brew_zsh" )
      if [ ! -f "$brew_zsh" ]; then
        echo 'Switch shell to /bin/zsh'
        chsh -s /bin/zsh
      fi
      ;;
    '/bin/bash' | '/bin/zsh' )
      if [ -f "$brew_zsh" ]; then
        echo "Switch shell to $brew_zsh"
        chsh -s "$brew_zsh"
      elif [ "$login_shell" != '/bin/zsh' ] && [ -f '/bin/zsh' ]; then
        echo 'Switch shell to /bin/zsh'
        chsh -s /bin/zsh
      fi
      ;;
  esac
}

install_mise_tools() {
  (cd "$HOME" && /opt/homebrew/bin/mise install --yes)
}

setup_powerline_fonts() {
  git submodule update --init
  sh .module/powerline-fonts/install.sh
}

log 'Change default shell to zsh:'
change_default_shell_to_zsh

log 'Install mise tools:'
install_mise_tools

log 'Setup powerline font:'
setup_powerline_fonts
